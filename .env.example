# ============================================================
# KLASS — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer .env avec des valeurs réelles
# ============================================================

# ---- Django ----
SECRET_KEY=changeme-insecure-secret-key-generate-a-new-one
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
ENVIRONMENT=development

# ---- PostgreSQL ----
DATABASE_URL=postgres://klass:klass@localhost:5432/klass
POSTGRES_DB=klass
POSTGRES_USER=klass
POSTGRES_PASSWORD=klass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Celery ----
CELERY_TASK_ALWAYS_EAGER=False

# ---- Domaine (multi-tenant) ----
# Domaine principal de la plateforme (ex: klass.app)
KLASS_DOMAIN=localhost

# ---- Email ----
DEFAULT_FROM_EMAIL=noreply@klass.app
SERVER_EMAIL=server@klass.app
# En développement, les emails sont affichés dans la console (EMAIL_BACKEND console)
# En production, configurer SMTP:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre@email.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-app

# ---- Stockage externe (Cloudflare R2 / Backblaze B2) ----
# Laisser False en développement (stockage local)
USE_EXTERNAL_STORAGE=False
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=
# STORAGE_ENDPOINT_URL=

# ---- Sentry (monitoring erreurs) ----
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---- SMS / WhatsApp (Africa's Talking) ----
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_SENDER_ID=

# ---- HTTPS (production uniquement) ----
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://klass.app,https://www.klass.app
